# ---- Database (Docker Compose default) ----
DATABASE_URL="postgresql://offgrid:offgrid@localhost:5432/offgrid?schema=public"

# ---- Supabase alternative ----
# DATABASE_URL="postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Auth.js (NextAuth v5) ----
AUTH_SECRET="run: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"

# ---- Stripe ----
# Keys: Stripe Dashboard → Developers → API keys (use test mode).
STRIPE_SECRET_KEY="sk_test_..."
# Local dev:  stripe listen --events checkout.session.completed,checkout.session.expired,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed,charge.refunded --forward-to localhost:3000/api/webhooks/stripe
#             (prints the whsec_... secret to use here; recent CLI versions
#             refuse to start without --events)
# Production: Dashboard → Developers → Webhooks → add endpoint
#             https://<your-domain>/api/webhooks/stripe with the events
#             checkout.session.completed, checkout.session.expired,
#             checkout.session.async_payment_succeeded,
#             checkout.session.async_payment_failed, charge.refunded
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
